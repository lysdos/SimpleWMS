# =====================================================
#  SimpleWMS  -  环境变量模板
#  复制为 .env 并填入真实值,git 忽略 .env
#  启动方式: docker compose --env-file .env up -d --build
# =====================================================

# ---------- MySQL ----------
# 注意:不要用 root 跑业务,务必单独建一个 wms 用户
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
MYSQL_USER=wms
MYSQL_PASSWORD=change-me-to-another-strong-password

# ⚠️  改 MySQL 密码后必须重置数据卷才能生效:
#       docker compose down -v    # -v 会删 mysql-data volume,数据全丢
#       docker compose up -d --build
#    原因:MySQL 镜像只在 data dir 为空(首次启动)时用 MYSQL_PASSWORD 建用户,
#    已存在的 volume 里用户密码不会被 env 改动。

# ---------- Backend (Spring Boot) ----------
# 首次启动建库的初始管理员账号。
# ⚠️ ADMIN_PASSWORD 不能与 'admin123' / 'change-me-now' / 'password' 同字面,
#    也不能 < 8 字符,否则 backend 启动直接失败(boot-time fail-fast)。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# JWT 签名密钥 —— 至少 32 字节,生产环境用 openssl rand -base64 48 生成
# 留空时容器启动会拒绝,强制你设一个
# 生成命令:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=24

# ---------- UHF-Rader 桥接(与 backend 共享 WMS 账号)----------
# 必须与上面的 ADMIN_USERNAME / ADMIN_PASSWORD 一致;docker-compose 不再给弱默认,
# 缺这两个变量 uhf-rader 容器直接启动失败。
WMS_USERNAME=admin
WMS_PASSWORD=change-me-to-a-strong-admin-password

# 登录限流豁免用的共享密钥(backend 与 uhf-rader 读同一个名字,值必须一致):
# UHF-Rader 的登录页与出库扫码自动登录共用一个容器,后端分不清两者 —— 一旦被登录失败
# 限流锁 5 分钟,现场整条扫码线就停摆,所以按容器整体豁免:配了它,本容器的登录请求
# 既不计失败、也不受锁定。留空则豁免关闭(照旧限流)。
# 生成命令:openssl rand -base64 32
WMS_LOGIN_NO_THROTTLE_TOKEN=

# 读卡器 TCP(根据现场实际改)
UHF_READER_HOST=192.168.1.209
UHF_READER_PORT=5000
# 设备号(UHF-Rader 通过此标识 WMS 系统中的设备)
UHF_DEVICE_CODE=MOCK-UHF-001
