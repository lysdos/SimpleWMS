# ============================================================
#  SimpleWMS .gitignore
# ============================================================

# 1) 构建产物
target/
*.class
*.jar
*.war
*.ear

# 1.1) 环境变量(包含密码/密钥)—— 只提交 .env.example
.env
.env.*
!.env.example

# 2) 运行时数据 / H2 文件(仅仓库根,避免误匹配 pda-android/app/src/main/java/com/wms/pda/data/)
/data/
*.mv.db
*.trace.db

# 3) 日志 / 临时
logs/
*.log
*.tmp
*.bak
*.swp
*.orig

# 4) IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# 5) OS
.DS_Store
Thumbs.db
desktop.ini

# 6) 本地工具/迁移脚本(临时)
tools/
!tools/.gitkeep

# 7) 容器卷数据(避免误提交)
docker-data/

# 8) 后端构建缓存 — 故意忽略,首次构建时 build.bat 会从本机 Maven 缓存自动同步
.m2-repo/

# 9) 其他工具/AI 内部目录(不属于本项目)
.superpowers/
.claude/
# 注意:docs/ 目录有意保留(产品 PRD / API 规范 / PDA 设计 等正式文档)

# 10) 临时文件 / 截图 / 一次性输出(测试时残留)
bc.png
bc_nginx.png
test-barcode.png
tmp_barcode.png
tmp.json
tmp2.json
tmp3.json
tmp_r.json
tmp_a.csv
tmp_b.csv
tmp_export.csv

# 11) 前端/工具链依赖 —— 需要时 npm install 自行生成,不入库
# (此前误提交过 153 个文件,且 .bin/*.cmd 是 Windows 绝对路径 shim,换机器即失效)
node_modules/
