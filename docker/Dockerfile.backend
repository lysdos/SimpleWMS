# =====================================================
#  SimpleWMS Backend - 多阶段构建
#  Stage 1: 用 Maven 镜像构建 jar (复用项目自带的 .m2-repo,断网也行)
#  Stage 2: 用 JRE 21 镜像运行,只带 jar,体积小
# =====================================================

# ---------- 构建阶段 ----------
FROM maven:3.9.6-eclipse-temurin-21 AS builder

WORKDIR /build

# 优先复制 pom 以利用 Docker 层缓存
COPY pom.xml .

# 复制源码(原 Dockerfile 遗漏,导致 repackage 找不到 main class)
COPY src ./src

# 在线编译 - 首次需联网下载依赖,后续会缓存到镜像层
RUN mvn -B -q -DskipTests package

# ---------- 运行阶段 ----------
FROM eclipse-temurin:21-jre

WORKDIR /app

# 安全:不以内置 root 身份运行,降低 RCE 后的影响面。
RUN groupadd --system wms && useradd --system --gid wms --home /app --shell /sbin/nologin wms \
 && apt-get update && apt-get install -y --no-install-recommends curl tini && rm -rf /var/lib/apt/lists/*

# 拷贝构建产物
COPY --from=builder /build/target/simple-wms.jar /app/app.jar
RUN chown -R wms:wms /app
USER wms

# 容器内默认编码 + JVM 调优
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    JAVA_OPTS="-Xms256m -Xmx512m"

EXPOSE 8080

# 健康检查:用 curl 探活(应用已起就能连上,401 也算 OK)。
# 2xx 视为健康,4xx/5xx/连接失败都视为不健康(应用还没起来)。
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS -o /dev/null -w '%{http_code}' http://localhost:8080/api/auth/me | grep -qE '^[24][0-9][0-9]$' || exit 1

# tini 收僵尸进程 + 转发信号,JVM 接到 SIGTERM 优雅退出
ENTRYPOINT ["/usr/bin/tini", "--", "sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]