        <mxCell id="e8" edge="1" parent="1" source="outbound" style="edgeStyle=none;html=1;dashed=1;endArrow=open;startArrow=none;" target="item_scan_row" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="stockcheck" style="edgeStyle=none;html=1;dashed=1;endArrow=open;startArrow=none;fontSize=10;fontColor=#999999;" target="item_stock_check_row" value="专属列表项">
          <mxGeometry relative="1" as="geometry" />
