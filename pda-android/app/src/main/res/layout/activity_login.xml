<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- 顶部条:Logo + 标题 + 设置入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_caption"
                android:alpha="0.85"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <!-- 大 Logo 占位 -->
            <View
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_kpi_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WMS"
                android:textColor="@color/primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md" />

            <!-- 服务器提示卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_xl"
                android:padding="@dimen/space_lg"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_server"
                    style="@style/Text.Caption" />

                <TextView
                    android:id="@+id/tv_server_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    style="@style/Text.Body"
                    android:textStyle="bold"
                    tools:text="http://10.0.2.2:8080"
                    xmlns:tools="http://schemas.android.com/tools" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_server_hint"
                    style="@style/Text.Caption"
                    android:layout_marginTop="@dimen/space_xs" />
            </LinearLayout>

            <!-- 账号 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_username"
                style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_lg" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_input"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:hint="操作员账号"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body"
                android:inputType="text"
                android:importantForAutofill="no" />

            <!-- 密码 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_password"
                style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_md" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_input"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:hint="••••••"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body"
                android:inputType="textPassword"
                android:importantForAutofill="no" />

            <!-- 记住账号 -->
            <CheckBox
                android:id="@+id/cb_remember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_remember"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/space_sm"
                android:checked="true" />

            <!-- 登录按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/login_button"
                android:textSize="@dimen/text_subtitle"
                app:cornerRadius="@dimen/card_corner"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_proto_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:text="原型版本 · 数据为模拟"
                style="@style/Text.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
