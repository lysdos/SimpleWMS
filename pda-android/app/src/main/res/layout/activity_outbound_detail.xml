<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="@string/outbound_detail_title"
        app:titleTextColor="@color/on_primary"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                style="@style/Card.SimpleWMS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Status.Pill" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    style="@style/Text.Body" />

                <TextView
                    android:id="@+id/tv_external_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body" />

                <TextView
                    android:id="@+id/tv_operator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body" />

                <TextView
                    android:id="@+id/tv_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:layout_marginTop="@dimen/space_xs" />

                <TextView
                    android:id="@+id/tv_remark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:layout_marginTop="@dimen/space_xs" />

                <LinearLayout
                    android:id="@+id/ll_header_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="end"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btn_header_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:text="@string/action_edit"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:background="?android:attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btn_header_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:text="@string/action_cancel_order"
                        android:textColor="@color/danger"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:background="?android:attr/selectableItemBackground" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_item"
                style="@style/Widget.SimpleWMS.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/inbound_add_item_action"
                android:textColor="@color/primary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_scan_frame">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/outbound_scan_hint"
                    style="@style/Text.Caption" />

                <!-- RFID 扫码(UHF) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_rfid_scan"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="RFID 扫码"
                        app:icon="@drawable/ic_scan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_rfid_stop"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="停止"
                        android:textColor="@color/on_primary"
                        android:visibility="gone"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>

                <!-- 条码扫码(硬件扫把头/摄像头) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_barcode_scan"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="条码扫码"
                        app:icon="@drawable/ic_scan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_barcode_stop"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="停止"
                        android:textColor="@color/on_primary"
                        android:visibility="gone"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_lines_outbound"
                    style="@style/Text.Subtitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_scans"
                    style="@style/Widget.SimpleWMS.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="清空扫码"
                    android:textColor="@color/primary"
                    app:iconTint="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                style="@style/Text.Body"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:id="@+id/ll_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_sm"
                android:layout_marginTop="@dimen/space_sm" />

            <!-- 已扫码记录 -->
            <TextView
                android:id="@+id/tv_scanned_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="扫码记录"
                style="@style/Text.Subtitle"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_scanned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_sm"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_complete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_lg"
        android:text="@string/btn_complete_outbound" />
</LinearLayout>