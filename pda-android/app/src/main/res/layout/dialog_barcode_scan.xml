<?xml version="1.0" encoding="utf-8"?>
<!-- 条码扫码面板(BarcodeScanDialog 用)。按钮由 AlertDialog 提供,这里只放取景区 + 手动输入。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <androidx.camera.view.PreviewView
        android:id="@+id/pv_scan"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <TextView
        android:id="@+id/tv_scan_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/scan_barcode_hint"
        style="@style/Text.Caption" />

    <EditText
        android:id="@+id/et_manual_code"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_input"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:hint="@string/scan_barcode_manual_hint"
        android:maxLines="1" />
</LinearLayout>
