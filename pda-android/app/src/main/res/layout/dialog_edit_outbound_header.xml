<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/outbound_header_customer_hint"
            style="@style/Text.Caption" />

        <EditText
            android:id="@+id/et_customer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_input"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/inbound_header_external_no_hint"
            style="@style/Text.Caption" />

        <EditText
            android:id="@+id/et_external_no"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_input"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/inbound_header_remark_hint"
            style="@style/Text.Caption" />

        <EditText
            android:id="@+id/et_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_input"
            android:padding="@dimen/space_md"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:inputType="textMultiLine"
            android:maxLines="3" />
    </LinearLayout>
</ScrollView>
