<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/tv_sku_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        tools:text="SKU-1001  蓝牙条码扫描枪"
        xmlns:tools="http://schemas.android.com/tools" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_xs">

        <TextView
            android:id="@+id/tv_barcode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="条码 6901234567001"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/tv_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            tools:text="× 10 台"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_line_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_line_edit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_edit"
            android:textSize="@dimen/text_caption"
            android:backgroundTint="@color/bg_subtle"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_line_delete"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minWidth="0dp"
            android:layout_marginStart="@dimen/space_xs"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_delete"
            android:textSize="@dimen/text_caption"
            android:backgroundTint="@color/danger"
            android:textColor="@color/on_primary" />
    </LinearLayout>
</LinearLayout>
