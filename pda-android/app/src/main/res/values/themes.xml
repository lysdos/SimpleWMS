<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SimpleWMS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.SimpleWMS.Button</item>
    </style>

    <!-- AndroidManifest 引用的 class 名(legacy 命名,保留 alias) -->
    <style name="Theme.SimpleWmsPda" parent="Theme.SimpleWMS" />

    <style name="Widget.SimpleWMS.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/card_corner</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="Widget.SimpleWMS.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/card_corner</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <!-- 命名 style 父级占位:Card.* / Status.* / Text.* 子 style 的隐式父 -->
    <style name="Card" />
    <style name="Status" />
    <style name="Text" />

    <style name="Card.SimpleWMS">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_lg</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Status.Pill">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
</resources>
